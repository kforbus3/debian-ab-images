# Build artifacts — never commit (images are multi-GB)
/output/
*.img
*.img.zst
*.img.gz
*.raucb

# Secrets / keys — never commit
/certs/
*.pem
*.key
*.crt
!server/**/*.conf

# Local config
server/.env
webui/.env

# Web UI build artifacts
node_modules/
webui/frontend/dist/
webui/frontend/.vite/
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Update signing key. The certificate is baked into every image built after it
# exists, so this pair must be kept — and must not be committed: anyone holding
# key.pem can sign an update the whole fleet will install.
output/rauc-keys/
# Your site-specific files: not the project's to carry.
overlay.d/*
!overlay.d/README.md

# Generated by the overlay-upload test (esbuild output, rebuilt by CI).
webui/frontend/src/lib/overlayUpload.built.mjs
