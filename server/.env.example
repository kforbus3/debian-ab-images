# Provisioning server configuration.
#
# You normally do NOT edit this file: the web UI's Provisioning page writes it,
# deriving every value below from the one interface you pick. Copy it to .env
# only if you drive the stack from the command line with `make server-up`.

# IP address of THIS provisioning server on the imaging network (required).
SERVER_IP=

# Prefix length for SERVER_IP. When set, the server assigns SERVER_IP to
# INTERFACE at startup if the NIC does not already have it, and brings the link
# up. A dedicated provisioning NIC usually has no address — nothing on that
# segment hands one out, because this server is what does. Applied at runtime
# only: a reboot reverts it and starting the server re-applies it, so the host's
# permanent network configuration stays untouched. Leave empty to manage the
# address yourself.
SERVER_PREFIXLEN=24

# The NIC facing the machines being imaged (required). DHCP and TFTP are bound
# to this interface alone, so they cannot reach — or disturb — any other network
# the host is attached to. Use a dedicated NIC, switch, or VLAN.
INTERFACE=

# Image to deploy — a filename present in ../output (required).
IMAGE_FILE=

# What each machine does after imaging: reboot | poweroff | shell
ACTION=reboot

# Address to also publish update bundles on (optional).
#
# The imaging listener is bound to SERVER_IP alone, so the image library is not
# exposed on any network but the provisioning one. A machine, though, is only on
# that segment while it is being imaged -- afterwards it lives on the LAN, which
# is exactly when `ab-update` needs to reach the server. Set this to the host's
# LAN address (or 0.0.0.0 for every interface) and /bundles/ is served there
# too. Nothing else is: /images/, /imager/ and /hosts/ stay where they were.
#
# Bundles are signed, and a machine only installs one signed by the certificate
# built into its own image, so serving them more widely does not weaken the
# update path. Leave empty to keep updates on the provisioning segment only.
UPDATE_IP=
UPDATE_PORT=80

# DHCP mode:
#   dhcp  (default) — standalone. This server owns the provisioning network and
#                     hands out its own leases; nothing else is needed.
#   proxy           — proxyDHCP. Answers only PXE questions and leaves IP leases
#                     to the network's existing DHCP server. Use when the
#                     machines must stay on a LAN you don't control.
MODE=dhcp

# --- MODE=dhcp (standalone) ---
DHCP_RANGE_START=
DHCP_RANGE_END=
DHCP_NETMASK=255.255.255.0
LEASE_TIME=1h
# Imaging needs no gateway or DNS; leave these unset unless you want them.
# DHCP_ROUTER=
# DHCP_DNS=

# --- MODE=proxy only ---
# Network address of the imaging LAN, e.g. 192.168.1.0
PROXY_SUBNET=
