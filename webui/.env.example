# Web UI configuration. Copy to webui/.env and edit.

# Login password for the UI (single admin). Required — pick a strong one; the
# UI controls the Docker socket, which is root on the host.
ADMIN_PASSWORD=

# Random secret for signing sessions. Required — generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ABSOLUTE host path to this repository. Optional — leave it empty. Compose
# mounts the repo root (`..`) and the UI detects the host-side path from that
# mount, which is what the builder/imager containers need.
#
# Set it ONLY if you run `docker compose` from outside this directory, and then
# it must be the absolute host path of THIS checkout. A wrong value mounts an
# empty directory and every build fails with:
#   unable to prepare context: path "/project/builder" not found
HOST_PROJECT_DIR=
